-- 10. ISSUE A BOOK
START TRANSACTION;

INSERT INTO IssueBooks
VALUES (1, 101, 1, '2026-10-15', NULL, 'Issued');

UPDATE Books
SET Quantity = Quantity - 1
WHERE BookID = 101 AND Quantity > 0;

COMMIT;

-- 11. DISPLAY ISSUED BOOK DETAILS
SELECT
    I.IssueID,
    S.StudentName,
    B.BookName,
    I.IssueDate,
    I.ReturnDate,
    I.Status
FROM IssueBooks I
JOIN Students S ON I.StudentID = S.StudentID
JOIN Books B ON I.BookID = B.BookID;

-- 12. RETURN A BOOK
START TRANSACTION;

UPDATE IssueBooks
SET Status = 'Returned',
    ReturnDate = '2026-10-20'
WHERE IssueID = 1 AND Status = 'Issued';

UPDATE Books
SET Quantity = Quantity + 1
WHERE BookID = 101
AND EXISTS (
    SELECT 1
    FROM IssueBooks
    WHERE IssueID = 1
      AND Status = 'Returned'
      AND ReturnDate = '2026-10-20'
);

COMMIT;

-- 13. DISPLAY FINAL ISSUE DETAILS
SELECT * FROM IssueBooks;

-- 14. DISPLAY UPDATED BOOK QUANTITY
SELECT * FROM Books;
